{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/documenta-prima-del-commit.cjs\"",
            "if": "Bash(git commit:*)",
            "timeout": 10,
            "statusMessage": "Checking the work is documented..."
          }
        ]
      }
    ]
  }
}
